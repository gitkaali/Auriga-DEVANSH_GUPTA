generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ActorType {
  USER
  SYSTEM
}

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  passwordHash   String
  name           String
  role           Role          @default(AGENT)
  isActive       Boolean       @default(true)
  assignedTickets Ticket[]     @relation("AssigneeTickets")
  createdTickets Ticket[]      @relation("CreatorTickets")
  auditRecords   AuditRecord[] @relation("UserAuditRecords")
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([role, isActive])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Ticket {
  id                  Int           @id @default(autoincrement())
  customerName        String
  title               String
  description         String
  priority            Priority      @default(NORMAL)
  status              TicketStatus  @default(OPEN)
  assigneeId          Int?
  assignee            User?         @relation("AssigneeTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId           Int
  creator             User          @relation("CreatorTickets", fields: [creatorId], references: [id], onDelete: Restrict)
  createdAt           DateTime      @default(now())
  promisedResponseAt  DateTime
  updatedAt           DateTime      @updatedAt
  auditRecords        AuditRecord[]

  @@index([status, promisedResponseAt])
  @@index([priority, promisedResponseAt])
  @@index([assigneeId, status])
  @@index([customerName])
  @@index([createdAt])
}

model AuditRecord {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action      String
  previousValue String?
  newValue    String?
  actorType   ActorType
  actorId     Int?
  actor       User?     @relation("UserAuditRecords", fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt  DateTime  @default(now())

  @@index([ticketId, occurredAt])
  @@index([action, occurredAt])
}
